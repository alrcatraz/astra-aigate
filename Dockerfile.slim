# ── Slim image for astra-aigate ────────────────────────────────────────────
# Uses pre-built standalone output from .build/next/standalone.
# The full Next.js build happened on the host — this Dockerfile only
# packages the result into a runtime container.

FROM node:26-trixie-slim AS base
WORKDIR /app

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends libsecret-1-0 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# ── Runner ────────────────────────────────────────────────────────────────
FROM base AS runner

# Copy the pre-built standalone output
COPY .build/next/standalone /app

# Copy public assets (served directly by Next.js)
COPY public /app/public

# Health check
COPY scripts/container/healthcheck.mjs /app/healthcheck.mjs
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node /app/healthcheck.mjs

EXPOSE 20128
ENV PORT=20128
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

# The standalone server is at server.js (next start wrapper)
CMD ["node", "server.js"]
